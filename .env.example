# General settings
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-a-random-string

# Local PostgreSQL database (used when DEBUG=True)
DB_NAME=poll_system_db
DB_USER=poll_admin
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Railway PostgreSQL (used when DEBUG=False)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://username:password@host:port/database

# Production hosts (used when DEBUG=False)
# Comma-separated list of allowed hosts
ALLOWED_HOSTS=your-production-domain.com,www.your-production-domain.com
CORS_ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com